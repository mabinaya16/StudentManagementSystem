<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.CheckBoxTableCell?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studentmanagement.AttendanceController"
      spacing="20"
      alignment="CENTER"
      stylesheets="@style.css">

    <Label text="Student Attendance"
           styleClass="form-title"/>

    <TableView fx:id="attendanceTable"
               prefWidth="650"
               prefHeight="350">

        <columns>

            <TableColumn fx:id="nameColumn"
                         text="Student Name"
                         prefWidth="220"/>

            <TableColumn fx:id="rollColumn"
                         text="Roll Number"
                         prefWidth="180"/>

            <TableColumn fx:id="presentColumn"
                         text="Present"
                         prefWidth="120"/>

        </columns>

    </TableView>

    <Button text="Save Attendance"
            onAction="#saveAttendance"
            styleClass="dashboard-button"/>

</VBox>