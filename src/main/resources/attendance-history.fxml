<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studentmanagement.AttendanceHistoryController"
      spacing="15"
      alignment="CENTER"
      stylesheets="@style.css">

    <!-- Title -->

    <Label text="Attendance History"
           styleClass="form-title"/>


    <!-- Date Filter -->

    <HBox spacing="10"
          alignment="CENTER">

        <DatePicker fx:id="datePicker"
                    promptText="Select Date"/>

        <Button text="Search Date"
                onAction="#searchByDate"
                styleClass="dashboard-button"/>

        <Button text="Show All"
                onAction="#showAllHistory"
                styleClass="dashboard-button"/>

    </HBox>


    <!-- Message -->

    <Label fx:id="messageLabel"
           text="Attendance History"/>


    <!-- Attendance Table -->

    <TableView fx:id="historyTable"
               prefWidth="750"
               prefHeight="400">

        <columns>

            <TableColumn fx:id="nameColumn"
                         text="Student Name"
                         prefWidth="200"/>

            <TableColumn fx:id="rollColumn"
                         text="Roll Number"
                         prefWidth="150"/>

            <TableColumn fx:id="dateColumn"
                         text="Date"
                         prefWidth="150"/>

            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="150"/>

        </columns>

    </TableView>


    <!-- Close Button -->

    <Button text="Close"
            onAction="#closeWindow"
            styleClass="dashboard-button"/>

</VBox>